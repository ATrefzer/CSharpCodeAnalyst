<Window x:Class="CSharpCodeAnalyst.Features.Import.ImportCppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:import="clr-namespace:CSharpCodeAnalyst.Features.Import"
        xmlns:resources="clr-namespace:CSharpCodeAnalyst.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance import:ImportCppDialogViewModel}"
        Title="{x:Static resources:Strings.ImportCpp_DialogTitle}" Width="520"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        MinWidth="420"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Explanatory text -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Description}"
                   TextWrapping="Wrap" />

        <!-- C++ source directory -->
        <TextBlock Grid.Row="2" Text="{x:Static resources:Strings.ImportCpp_SourceDirectory_Label}" Margin="0,0,0,5" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SourceDirectory, UpdateSourceTrigger=PropertyChanged}"
                     Height="25"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1"
                    Content="..."
                    Width="30"
                    Height="25"
                    Margin="2,0,0,0"
                    Click="BrowseSourceDirectory_Click" />
        </Grid>
        <TextBlock Grid.Row="4"
                   Text="{Binding SourceDirectoryError}"
                   Foreground="Red"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,3,0,0" />

        <!-- Project name -->
        <TextBlock Grid.Row="6" Text="{x:Static resources:Strings.ImportCpp_ProjectName_Label}" Margin="0,0,0,5" />
        <TextBox Grid.Row="7"
                 Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                 Height="25"
                 VerticalContentAlignment="Center" />

        <!-- Buttons -->
        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{x:Static resources:Strings.History_OkButton}"
                    Width="75"
                    Click="OkButton_Click"
                    IsEnabled="{Binding CanAccept}"
                    IsDefault="True"
                    Margin="0,0,10,0" />
            <Button Content="{x:Static resources:Strings.History_CancelButton}"
                    Width="75"
                    Click="CancelButton_Click"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
